import java.util.*;

public class OptimalStorage {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] files = new int[n];

        for (int i = 0; i < n; i++) {
            files[i] = sc.nextInt();
        }

        Arrays.sort(files);

        int sum = 0;
        int totalRetrievalTime = 0;

        for (int i = 0; i < n; i++) {
            sum += files[i];
            totalRetrievalTime += sum;
        }

        double average = (double) totalRetrievalTime / n;

        System.out.println("Optimal order: " + Arrays.toString(files));
        System.out.println("Average retrieval time: " + average);
    }
}
